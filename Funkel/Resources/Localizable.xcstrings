    "backup.footer": {
      "comment": "UI text (iOS and web).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei enthält alle Profile mit Sternen, Garten und Fortschritt. Speichere sie zum Beispiel in «Dateien» oder iCloud Drive. Sie bleibt bei dir: Funkel lädt nichts hoch."
          }
        }
      }
    },
