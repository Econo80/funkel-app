      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudokus passen sich dem Alter an: Bilder-Sudokus (4×4) für die Jüngsten, Zahlen ab 6, 6×6 ab 8 und klassische 9×9 ab 10. Ein gelöstes Sudoku bringt Sterne, mit Tipps etwas weniger."
          }
        }
      }
    },
