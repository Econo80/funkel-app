    "editor.level.footer": {
      "comment": "UI text (iOS and web).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit − und + stellst du das Niveau pro Fach in halben Jahren ein. Sterne, Serie und Fortschritt bleiben, wie sie sind. Danach passt sich jedes Fach weiter von selbst an: nach zwei fehlerfreien Runden wird es schwieriger, wenn es nicht so gut läuft, leichter."
          }
        }
      }
    },
